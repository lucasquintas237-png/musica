// Configuración para publicar la app como Worker de Cloudflare (con archivos estáticos).
// El nombre debe coincidir con el del Worker creado en el panel de Cloudflare.
{
  "name": "musica",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    // la web está en la raíz del repositorio; .assetsignore deja fuera lo que no es de la web
    "directory": ".",
    "binding": "ASSETS"
  },
  // base de datos de las cuentas (Cloudflare D1, gratis). Sin "database_id", wrangler la crea
  // sola al publicar; si tu versión no lo hace, créala en el panel (Storage & databases > D1)
  // con el nombre "musica-db" y añade aquí "database_id": "<su id>".
  "d1_databases": [
    { "binding": "DB", "database_name": "musica-db" }
  ],
  // Secreto DATA_KEY (NO va aquí ni en el código): clave con la que se cifran los datos de las
  // cuentas y se protegen las contraseñas (server/crypto.js). Se pone en el panel de Cloudflare:
  // Workers & Pages > musica > Settings > Variables and Secrets > Add > tipo "Secret".
  // Una vez puesto, no lo cambies ni lo borres: sin él no se pueden leer los datos ni entrar.
  "observability": { "enabled": true }
}
